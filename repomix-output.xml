    if (!payload.feedbackId) throw new Error("CLASSIFICATION_JOB_PAYLOAD_INVALID");
    await classifyAndPersist(payload.feedbackId, claimed.workspaceId);
  });
  return NextResponse.json({ processed: Boolean(job), jobId: job?.id ?? null });
}
