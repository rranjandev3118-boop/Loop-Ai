.landing-signal-line { position: absolute; z-index: 1; height: 1px; transform-origin: left; background: linear-gradient(90deg, rgba(99,102,241,.05), rgba(34,211,238,.7), rgba(99,102,241,.05)); box-shadow: 0 0 12px rgba(34,211,238,.4); }
.landing-signal-line-one { left: 14%; top: 31%; width: 310px; transform: rotate(12deg); }.landing-signal-line-two { left: 51%; top: 33%; width: 220px; transform: rotate(-25deg); }
.landing-float-card { position: absolute; z-index: 4; display: flex; align-items: center; gap: 9px; border: 1px solid rgba(255,255,255,.8); border-radius: 15px; padding: 10px 12px; background: rgba(255,255,255,.74); box-shadow: 0 16px 32px rgba(30,41,59,.13); backdrop-filter: blur(14px); }
