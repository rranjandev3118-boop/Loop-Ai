# Database Configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&connection_limit=10"

# NextAuth Configuration
NEXTAUTH_SECRET="replace-with-a-long-random-secret-min-32-characters"
NEXTAUTH_URL="https://your-domain.com"

# Anthropic AI Configuration
ANTHROPIC_API_KEY="your-anthropic-key"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Cron Job Security
CRON_SECRET="replace-with-a-long-random-secret-min-32-characters"

# Email Configuration (Resend)
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="LOOP <no-reply@your-domain.com>"

# Environment
NODE_ENV="production"

# Optional: Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# Optional: Logging
LOG_LEVEL="info"
